# Application (4000 avoids common local :3000 conflicts)
PORT=4000
NODE_ENV=development

# Postgres (docker compose host port 5433 → container 5432)
DATABASE_URL=postgresql://opoha:opoha@localhost:5433/opoha

# Redis (docker compose host port 6380 → container 6379)
REDIS_URL=redis://localhost:6380

# Logging: fatal | error | warn | info | debug
LOG_LEVEL=info

# OpenTelemetry (B-05) — off by default; set true to register console span exporter
OTEL_ENABLED=false

# API versioning (B-06): clients may send header X-API-Version: 1 | 2026-08-03
# (omit to default to 1). See docs/architecture/api-versioning.md in opoha-workspace.

# JWT auth (C-03/C-04) — required in production (fail-fast if missing when NODE_ENV=production).
# Dev/test fall back to an insecure built-in secret when unset; never use that in prod.
# JWT_SECRET=replace-with-a-long-random-secret
# JWT_EXPIRES_IN=1h
# Opaque refresh-token lifetime (hashed in DB; rotated on each refresh mutation).
# JWT_REFRESH_EXPIRES_IN=7d

# Machine auth (C-06): send header X-API-Key: <secret> instead of Authorization: Bearer <jwt>.
# Create keys via createApiKey GraphQL mutation (secret returned once).

# Plugins (D-03) — either or both:
# Explicit roots (comma-separated or JSON array of directories):
# OPOHA_PLUGINS=../plugin-manual-payment,../plugin-storage-localfs
# Or a parent directory whose child folders each contain opoha.plugin.json / package.json#opoha:
# OPOHA_PLUGINS_PATH=../plugins

# Optional seed admin (B-07) — both required to create a user; leave unset to seed roles/permissions only.
# Do not commit real passwords. Documented local-dev example values (copy into .env, not committed):
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-in-local-dev
