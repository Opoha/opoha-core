# Application (4000 avoids common local :3000 conflicts)
PORT=4000
NODE_ENV=development

# Postgres (docker compose host port 5433 → container 5432)
DATABASE_URL=postgresql://opoha:opoha@localhost:5433/opoha

# Redis (docker compose host port 6380 → container 6379)
REDIS_URL=redis://localhost:6380

# Logging: fatal | error | warn | info | debug
LOG_LEVEL=info

# OpenTelemetry (B-05) — off by default; set true to register console span exporter
OTEL_ENABLED=false

# API versioning (B-06): clients may send header X-API-Version: 1 | 2026-08-03
# (omit to default to 1). See docs/architecture/api-versioning.md in opoha-workspace.
