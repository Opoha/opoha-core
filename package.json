{
  "name": "@opoha/core",
  "version": "1.0.0",
  "description": "Opoha commerce engine — NestJS modular monolith runtime",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist",
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps --watch dist/main.js",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:boundary": "vitest run src/boundary.test.ts",
    "foundations-smoke": "vitest run src/modules/omnichannel/omnichannel-foundations.smoke.test.ts src/modules/catalog/entities/fulfillment-mode.test.ts src/modules/order/entities/order-source.test.ts src/boundary.test.ts",
    "digital-smoke": "vitest run src/modules/digital/digital-gate.smoke.test.ts src/modules/digital/digital-fulfillment.service.test.ts src/boundary.test.ts",
    "jobs-smoke": "vitest run src/modules/jobs/jobs-gate.smoke.test.ts src/modules/jobs/jobs.service.test.ts src/modules/jobs/cron-expression.test.ts src/modules/jobs/job-status.test.ts src/boundary.test.ts",
    "rules-smoke": "vitest run src/modules/rules/rules-gate.smoke.test.ts src/modules/rules/rules-evaluator.service.test.ts src/modules/rules/rules.service.test.ts src/modules/rules/rule-conditions.test.ts src/boundary.test.ts",
    "webhooks-unit": "vitest run src/modules/webhooks src/boundary.test.ts",
    "webhooks-smoke": "vitest run src/modules/webhooks/webhooks-gate.smoke.test.ts src/modules/webhooks/webhook-delivery.worker.test.ts src/modules/webhooks/webhook-dispatcher.service.test.ts src/modules/webhooks/webhook-signing.test.ts src/modules/webhooks/webhook-status.test.ts src/boundary.test.ts",
    "omnichannel-smoke": "node ./scripts/omnichannel-smoke.mjs",
    "automation-smoke": "node ./scripts/automation-smoke.mjs",
    "perf-bench": "vitest run src/modules/perf/perf-benchmark.smoke.test.ts src/modules/perf/perf-timing.test.ts src/boundary.test.ts",
    "plugin-compat-smoke": "vitest run src/modules/plugin-loader/plugin-compat.integration.test.ts src/boundary.test.ts",
    "stable-smoke": "node ./scripts/stable-smoke.mjs",
    "walking-skeleton": "node ./scripts/walking-skeleton.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d database/data-source.ts",
    "db:seed": "tsx database/seed.ts",
    "dev:tsx": "tsx watch src/main.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "db:migrate:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d database/data-source.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.0.3",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/graphql": "^13.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "dotenv": "^17.4.2",
    "graphql": "^16.10.0",
    "ioredis": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3",
    "@nestjs/typeorm": "^11.0.0",
    "typeorm": "0.3.27",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@opoha/eslint-config": "^1.0.0",
    "@opoha/prettier-config": "^1.0.0",
    "@opoha/typescript-config": "^1.0.0",
    "@opoha/vitest-config": "^1.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "@types/pg": "^8.11.11"
  },
  "prettier": "@opoha/prettier-config",
  "packageManager": "pnpm@11.7.0"
}
