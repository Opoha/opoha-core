{
  "name": "@opoha/core",
  "version": "0.1.0",
  "description": "Opoha commerce engine — NestJS modular monolith runtime",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@opoha/eslint-config": "file:../opoha-devkit/packages/eslint-config",
    "@opoha/prettier-config": "file:../opoha-devkit/packages/prettier-config",
    "@opoha/typescript-config": "file:../opoha-devkit/packages/typescript-config",
    "@opoha/vitest-config": "file:../opoha-devkit/packages/vitest-config",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "prettier": "@opoha/prettier-config"
}
