{
  "name": "@opoha/core",
  "version": "0.1.0",
  "description": "Opoha commerce engine \u2014 NestJS modular monolith runtime",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps --watch dist/main.js",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema=database/prisma",
    "prisma:migrate": "prisma migrate dev --schema=database/prisma",
    "prisma:studio": "prisma studio --schema=database/prisma",
    "prisma:seed": "prisma db seed",
    "db:migrate": "prisma migrate deploy --schema=database/prisma",
    "db:seed": "prisma db seed",
    "dev:tsx": "tsx watch src/main.ts"
  },
  "prisma": {
    "schema": "database/prisma",
    "seed": "tsx database/prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.0.3",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/graphql": "^13.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "graphql": "^16.10.0",
    "ioredis": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opoha/eslint-config": "file:../opoha-devkit/packages/eslint-config",
    "@opoha/prettier-config": "file:../opoha-devkit/packages/prettier-config",
    "@opoha/typescript-config": "file:../opoha-devkit/packages/typescript-config",
    "@opoha/vitest-config": "file:../opoha-devkit/packages/vitest-config",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "prettier": "@opoha/prettier-config",
  "packageManager": "pnpm@11.7.0"
}
